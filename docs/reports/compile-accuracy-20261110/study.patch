diff --git a/regional_runtime.py b/regional_runtime.py
new file mode 100644
index 0000000..040c645
--- /dev/null
+++ b/regional_runtime.py
@@ -0,0 +1,56 @@
+"""Region compiler entry outside FSDP/checkpoint control logic, with per-rank compile receipts."""
+import json
+import os
+from pathlib import Path
+import torch
+from torch.utils.checkpoint import checkpoint
+
+
+def install_regional_compile(model, output_dir, enabled=True):
+    # Shared wrapper specializes on layer identity, QKV/output phase, and dtype.
+    torch._dynamo.config.recompile_limit = 256
+    torch._dynamo.config.accumulated_recompile_limit = 4096
+    from lingbotvla.distributed.torch_parallelize import _resolve
+    core=model.model.qwenvl_with_expert
+    vlm,_=_resolve(core.qwenvl,[("model","language_model","layers"),("model","layers")])
+    expert=core.qwen_expert.model.layers
+    path=Path(output_dir).parent/f'region_compile_rank{os.environ.get("RANK","0")}.jsonl'
+    if os.environ.get('STUDY_CODEGEN')=='1' and os.environ.get('RANK')=='0':
+        import torch._inductor.config as inductor_config
+        inductor_config.trace.enabled=True
+        inductor_config.fx_graph_cache=False  # Profile only: force generated IR/code evidence, retain kernel binary caches.
+        inductor_config.trace.debug_dir=str(Path(output_dir).parent/'codegen')
+    # A fullgraph error or cache-limit exception must fail the smoke test, not quietly run eager.
+    def backend(gm, example_inputs):
+        if os.environ.get('STUDY_CODEGEN')=='1' and os.environ.get('RANK')=='0':
+            root=Path(output_dir).parent/'fx';root.mkdir(exist_ok=True)
+            index=len(list(root.glob('*.txt')))
+            (root/f'{index:03d}.txt').write_text(gm.print_readable(print_output=False))
+        with path.open('a') as f:
+            f.write(json.dumps(dict(nodes=len(list(gm.graph.nodes)),targets=[str(n.target) for n in gm.graph.nodes if n.op.startswith('call')]))+'\n')
+        if os.environ.get('STUDY_PRESERVE_CASTS')=='1':
+            return torch._inductor.compile(gm,example_inputs,options={'emulate_precision_casts':True})
+        return torch._dynamo.lookup_backend('inductor')(gm,example_inputs)
+    def wrap(forward,label):
+        def checkpointed(*args,**kwargs):
+            return checkpoint(forward,*args,use_reentrant=False,**kwargs)
+        entry=torch.compile(checkpointed,backend=backend,fullgraph=True,dynamic=False) if enabled else checkpointed
+        @torch.compiler.disable
+        def invoke(*args,**kwargs):
+            from regional_numeric import boundary
+            phase='qkv' if kwargs.get('compute_kqv',False) else 'omlp'
+            boundary(label+'.'+phase+'.input',args)
+            if os.environ.get('STUDY_PROFILE')=='1':
+                with torch.profiler.record_function('decoder.'+label+'.'+phase):
+                    result=entry(*args,**kwargs)
+            else:
+                result=entry(*args,**kwargs)
+            boundary(label+'.'+phase+'.output',result,register_grad=True)
+            return result
+        return invoke
+    for label,layer in [(f"vlm.{i:02d}",x) for i,x in enumerate(vlm)]+[(f"expert.{i:02d}",x) for i,x in enumerate(expert)]:
+        original=layer.forward
+        # All four cells share this boundary: FSDP __call__ hooks outside pure-forward checkpoint.
+        layer.gradient_checkpointing=False
+        layer.forward=wrap(original,label)
+    (Path(output_dir).parent/'region_install.json').write_text(json.dumps(dict(vlm_layers=len(vlm),expert_layers=len(expert),fullgraph=enabled,checkpoint_boundary='pure-forward-hooks-outside',regional=enabled,preserve_casts=os.environ.get('STUDY_PRESERVE_CASTS')=='1'),indent=2))
